# ======================= StudyMind AI + Strands Decider 2B =======================
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
ENVIRONMENT=development
APP_ENV=development
PORT=8000

# ---- Amazon Bedrock (writes the text) ----
# Credentials: `aws login` / `aws configure` / AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN)
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_DEEP=us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_PROVIDER=bedrock

# ---- Strands Decider 2B (makes the decisions) ----
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_ALLOW_FALLBACK=true        # false = never use the labelled keyword fallback (gate fails open instead)
DECIDER_CONTEXT_SCORING=true       # score each retrieved chunk before it reaches the prompt

# ---- Optional: Groq backs up the long tail of helper features (quiz generation, ingestion, etc.) ----
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

LLM_MODEL_FAST=openai/gpt-oss-20b
EMBEDDING_PROVIDER=transformers
VISION_PROVIDER=groq
STT_PROVIDER=groq

# ---- Supabase (optional - the app falls back to a local JSON store) ----
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=course-materials

RETRIEVAL_CONFIDENCE_THRESHOLD=0.20
MAX_RETRIEVED_CHUNKS=5
